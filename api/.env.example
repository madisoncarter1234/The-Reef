# Server
PORT=3000
NODE_ENV=development

# Database (Turso)
# For local development, use file-based SQLite
DATABASE_URL="file:./dev.db"
# For production with Turso:
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-auth-token"

# Blockchain (Base Sepolia)
CHAIN_ID=84532
RPC_URL="https://sepolia.base.org"
REGISTRY_ADDRESS="0x974309912ec808E8bdC6DFFE77013045309E18de"
TOKEN_ADDRESS="0x19C4bE267ab8D47eEEC8299da77D447e73F7B9C7"
REGISTRY_DEPLOY_BLOCK=37023861

# IPFS (Pinata)
PINATA_JWT="your-pinata-jwt"
PINATA_GATEWAY="your-gateway.mypinata.cloud"

# Auth
# EIP-712 domain for signature verification
EIP712_DOMAIN_NAME="The Reef"
EIP712_DOMAIN_VERSION="1"
